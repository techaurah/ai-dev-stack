# Copy to .env and fill in the keys you have. Every key is optional on its own;
# the gateway routes only to providers whose key is set. NEVER commit .env.
# How to get each key (all free, no credit card): see docs/free-routes.md

# Rank 1: NVIDIA NIM free tier (build.nvidia.com -> API Keys, key starts nvapi-)
NVIDIA_API_KEY=
# Rank 2: OpenRouter (openrouter.ai -> Keys; free :free models, 50 req/day)
OPENROUTER_API_KEY=
# Rank 3: Groq free tier (console.groq.com -> API Keys, key starts gsk_)
GROQ_API_KEY=
# Rank 4: Google AI Studio (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
# Rank 5: GitHub Models (github.com -> Settings -> Developer settings ->
# Fine-grained PAT with the models:read permission only)
GITHUB_MODELS_TOKEN=

# Optional: pin your own gateway master key (else start-gateway.sh generates one)
LITELLM_MASTER_KEY=

# Optional, NOT free: a real Anthropic key if you later choose direct Claude access
ANTHROPIC_API_KEY=
